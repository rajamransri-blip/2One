# Local default. Production: APP_ENV=production, PostgreSQL/Supabase DATABASE_URL,
# SUPABASE_URL and SUPABASE_ANON_KEY; configure HTTPS reverse proxy.
APP_ENV=local
DATABASE_URL=sqlite:///./child_safety.db
JWT_SECRET=replace-with-at-least-32-cryptographically-random-characters
SUPABASE_URL=
SUPABASE_ANON_KEY=
MEDIA_DIR=./private_media
MAX_WS_CONNECTIONS=200
REQUESTS_PER_MINUTE=120
LOCATION_RETENTION_DAYS=30
ONLINE_SECONDS=180
PAIR_CODE_MINUTES=10
